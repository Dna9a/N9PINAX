# N9pinax — Network Security Scanner
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `python3 -c "import secrets; print(secrets.token_hex(32))"`
# deploy.sh auto-generates a strong value while this placeholder is unchanged.
SCANNER_JWT_SECRET=replace-with-a-strong-random-secret

# ── API server ─────────────────────────────────────────────────────────────────
SCANNER_API_HOST=0.0.0.0
SCANNER_API_PORT=8000

# Comma-separated list of allowed CORS origins. Use * for development only.
SCANNER_API_CORS=*

# ── Persistence ────────────────────────────────────────────────────────────────
# Paths inside the container (or on the host when running without Docker)
SCANNER_DB_PATH=/data/scans.db
SCANNER_REPORT_PATH=/data/scan_report.txt
SCANNER_LOG_PATH=/data/scanner.log

# ── Redis (optional) ──────────────────────────────────────────────────────────
# Cache + cross-worker rate limiting. The app falls back to in-process behaviour
# if Redis is unreachable. Use redis://redis:6379/0 under docker-compose, or
# redis://127.0.0.1:6379/0 for a local/host-networked Redis.
REDIS_URL=redis://redis:6379/0

# ── Scan behaviour ─────────────────────────────────────────────────────────────
# Per-port TCP connect timeout in seconds
SCANNER_PORT_TIMEOUT=0.5

# Concurrent port-scan threads per host
SCANNER_MAX_WORKERS_PORTS=50

# Outbound packets per second (rate limit to avoid IDS noise)
SCANNER_RATE_LIMIT_PPS=500

# Enable the alert engine (SIEM rules)
SCANNER_ALERTS=true

# Enable passive DHCP fingerprinting (off by default — requires a sniff window)
SCANNER_DHCP=false

# ── Optional (override defaults) ──────────────────────────────────────────────
# SCANNER_ARP_TIMEOUT=2.0
# SCANNER_ICMP_TIMEOUT=1.0
# SCANNER_SYN_TIMEOUT=1.5
# SCANNER_UDP_TIMEOUT=2.0
# SCANNER_DNS_TIMEOUT=1.0
# SCANNER_MAX_WORKERS_HOSTS=16
# SCANNER_MAX_WORKERS_DNS=20
# SCANNER_API_RATE_PER_MIN=60
# SCANNER_KEEP_LAST_N_SCANS=200